{
  "name": "homepage",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "UAPI_KEY": "你的_uapis_key",
    "SONG_API_UPSTREAM": "https://api.injahow.cn/meting",
    "VITE_SITE_NAME": "你的站点名称",
    "VITE_SITE_AUTHOR": "你的昵称",
    "VITE_SITE_KEYWORDS": "个人主页",
    "VITE_SITE_DES": "站点简介",
    "VITE_SITE_URL": "example.com",
    "VITE_SITE_LOGO": "/images/icon/favicon.ico",
    "VITE_SITE_MAIN_LOGO": "/images/icon/apple-touch-icon.png",
    "VITE_SITE_START": "2024",
    "VITE_SONG_API": "/api/song",
    "VITE_SONG_SERVER": "netease",
    "VITE_SONG_TYPE": "playlist",
    "VITE_SONG_ID": "9333187603"
  }
}
